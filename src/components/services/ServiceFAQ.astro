---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  intro?: string;
  items: FaqItem[];
}

const {
  title = "Perguntas Frequentes",
  intro = "Respostas objetivas para acelerar a decisão da sua equipa.",
  items,
} = Astro.props;
---

<section class="space-y-5">
  <div class="space-y-2">
    <h2 class="text-3xl text-slate-900 md:text-4xl">{title}</h2>
    <p class="max-w-3xl text-slate-600">{intro}</p>
  </div>

  <div class="space-y-3">
    {items.map((item) => (
      <details class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <summary class="cursor-pointer list-none pr-8 text-base font-semibold text-slate-900 marker:content-none">
          {item.question}
          <span class="float-right ml-3 text-slate-400 transition group-open:rotate-45">+</span>
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-slate-600">{item.answer}</p>
      </details>
    ))}
  </div>
</section>
