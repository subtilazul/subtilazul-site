---
interface ProblemItem {
  title: string;
  description: string;
}

interface Props {
  title?: string;
  intro?: string;
  items: ProblemItem[];
}

const {
  title = "Problemas que resolvemos",
  intro = "Situações recorrentes que tratamos com metodologia técnica e execução planeada.",
  items,
} = Astro.props;
---

<section class="space-y-5">
  <div class="space-y-2">
    <h2 class="text-3xl text-slate-900 md:text-4xl">{title}</h2>
    <p class="max-w-3xl text-slate-600">{intro}</p>
  </div>

  <ul class="grid gap-4 md:grid-cols-2">
    {items.map((item) => (
      <li class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <h3 class="text-xl text-slate-900">{item.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.description}</p>
      </li>
    ))}
  </ul>
</section>
