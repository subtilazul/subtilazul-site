---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  primaryCtaLabel?: string;
  primaryCtaHref?: string;
  secondaryCtaLabel?: string;
  secondaryCtaHref?: string;
  highlights?: string[];
}

const {
  eyebrow = "Solução para Empresas",
  title,
  description,
  primaryCtaLabel = "Pedir Avaliação Gratuita",
  primaryCtaHref = "#contacto",
  secondaryCtaLabel = "Falar com Especialista",
  secondaryCtaHref = "mailto:geral@subtilazul.pt",
  highlights = [],
} = Astro.props;
---

<section class=" ">
  <div class="grid gap-6">
    <div class="space-y-4">      
      <h1 class="text-4xl text-slate-900 md:text-4xl">{title}</h1>
      <p class="max-w-6xl text-base leading-relaxed text-slate-600 md:text-lg">{description}</p>
    </div>

    <div class="flex flex-wrap items-center gap-3 md:justify-end">
      <a
        href={primaryCtaHref}
        class="inline-flex items-center justify-center rounded-full bg-cyan-700 px-6 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-cyan-800"
      >
        {primaryCtaLabel}
      </a>
      
    </div>
  </div>

  {highlights.length > 0 && (
    <ul class="mt-6 grid gap-3 text-sm text-slate-700 sm:grid-cols-2 lg:grid-cols-3">
      {highlights.map((item) => (
        <li class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">{item}</li>
      ))}
    </ul>
  )}
</section>
