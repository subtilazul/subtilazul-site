---
interface ProcessStep {
  title: string;
  description: string;
}

interface Props {
  title?: string;
  intro?: string;
  steps: ProcessStep[];
}

const {
  title = "Processo de Execução",
  intro = "Metodologia clara para garantir previsibilidade e qualidade de entrega.",
  steps,
} = Astro.props;
---

<section class="space-y-5">
  <div class="space-y-2">
    <h2 class="text-3xl text-slate-900 md:text-4xl">{title}</h2>
    <p class="max-w-3xl text-slate-600">{intro}</p>
  </div>

  <ol class="grid gap-4 md:grid-cols-2">
    {steps.map((step, index) => (
      <li class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="mb-3 text-xs font-semibold tracking-[0.14em] text-cyan-700">ETAPA {index + 1}</p>
        <h3 class="text-xl text-slate-900">{step.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">{step.description}</p>
      </li>
    ))}
  </ol>
</section>
