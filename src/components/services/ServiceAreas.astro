---
interface AreaItem {
  name: string;
  note?: string;
}

interface Props {
  title?: string;
  intro?: string;
  areas: AreaItem[];
}

const {
  title = "Áreas Atendidas",
  intro = "Operação focada no Norte de Portugal, com planeamento técnico para ambientes corporativos e institucionais.",
  areas,
} = Astro.props;
---

<section class="space-y-5">
  <div class="space-y-2">
    <h2 class="text-3xl text-slate-900 md:text-4xl">{title}</h2>
    <p class="max-w-3xl text-slate-600">{intro}</p>
  </div>

  <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-sm md:p-7">
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {areas.map((area) => (
        <li class="rounded-2xl border border-slate-200 bg-slate-50 px-4 py-3">
          <p class="text-sm font-semibold text-slate-900">{area.name}</p>
          {area.note && <p class="mt-1 text-xs text-slate-500">{area.note}</p>}
        </li>
      ))}
    </ul>
  </div>
</section>
