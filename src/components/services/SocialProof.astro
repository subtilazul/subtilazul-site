---
interface StatItem {
  value: string;
  label: string;
}

interface TestimonialItem {
  quote: string;
  author: string;
  role?: string;
}

interface Props {
  title?: string;
  intro?: string;
  stats?: StatItem[];
  testimonials?: TestimonialItem[];
}

const {
  title = "Prova Social",
  intro = "Confiança construída com resultados consistentes em contexto empresarial e institucional.",
  stats = [],
  testimonials = [],
} = Astro.props;
---

<section class="space-y-5">
  <div class="space-y-2">
    <h2 class="text-3xl text-slate-900 md:text-4xl">{title}</h2>
    <p class="max-w-3xl text-slate-600">{intro}</p>
  </div>

  {stats.length > 0 && (
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {stats.map((item) => (
        <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-3xl font-semibold text-cyan-800">{item.value}</p>
          <p class="mt-1 text-sm text-slate-600">{item.label}</p>
        </article>
      ))}
    </div>
  )}

  {testimonials.length > 0 && (
    <div class="grid gap-4 md:grid-cols-2">
      {testimonials.map((item) => (
        <blockquote class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <p class="text-sm leading-relaxed text-slate-700">“{item.quote}”</p>
          <footer class="mt-4 text-xs text-slate-500">
            <span class="font-semibold text-slate-700">{item.author}</span>
            {item.role && <span> · {item.role}</span>}
          </footer>
        </blockquote>
      ))}
    </div>
  )}
</section>
