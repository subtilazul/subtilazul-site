---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/sections/Navbar.astro";
import Footer from "../../components/sections/Footer.astro";
---

<Layout
  title="Serviços de Higienização Profissional | SúbtilAzul"
  description="Conheça os serviços profissionais da SúbtilAzul para empresas e instituições: lavagem de alcatifas, higienização de cadeiras de auditório e higienização de colchões para hotelaria."
>
  <Navbar />

  <main class="pb-16 pt-24 md:pb-24 md:pt-28">
    <section class="px-4 md:px-6">
      <div class="mx-auto w-full max-w-7xl">
        <div class=" p-6  md:p-10">
          <p class="inline-flex rounded-full border border-cyan-200 bg-cyan-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-cyan-800">
            Serviços SúbtilAzul
          </p>
          <h1 class="mt-4 text-4xl leading-tight text-slate-900 md:text-5xl">
            Soluções de Higienização para Empresas e Instituições
          </h1>
          <p class="mt-4 text-base leading-relaxed text-slate-600 md:text-lg">
            Desenvolvemos intervenções técnicas de higienização com foco em qualidade operacional,
            preservação de ativos e conforto dos utilizadores.
          </p>
        </div>
      </div>
    </section>

    <section class="mt-10 px-4 md:mt-14 md:px-6">
      <div class="mx-auto grid w-full max-w-5xl gap-8">
        <a href="/servicos/lavagem-alcatifas" class="group rounded-3xl border border-slate-200 bg-white p-9 shadow-sm transition hover:-translate-y-1 hover:shadow-md md:p-10">
          <h2 class="text-3xl text-slate-900 transition group-hover:text-cyan-800">Lavagem de Alcatifas</h2>
          <p class="mt-4 text-base leading-relaxed text-slate-600">
            Higienização profunda de alcatifas em áreas de tráfego intenso, escritórios, auditórios e zonas comuns.
          </p>
          <p class="mt-6 text-base font-semibold text-cyan-700">Ver serviço</p>
        </a>

        <a href="/servicos/higienizacao-cadeiras" class="group rounded-3xl border border-slate-200 bg-white p-9 shadow-sm transition hover:-translate-y-1 hover:shadow-md md:p-10">
          <h2 class="text-3xl text-slate-900 transition group-hover:text-cyan-800">Higienização de Cadeiras</h2>
          <p class="mt-4 text-base leading-relaxed text-slate-600">
            Limpeza técnica de cadeiras estofadas em auditórios e salas de conferência com planeamento operacional.
            Também para cadeiras de escritório, poltronas e sofás em ambientes corporativos.
          </p>
          <p class="mt-6 text-base font-semibold text-cyan-700">Ver serviço</p>
        </a>        
      </div>
    </section>
  </main>

  <Footer />
  <script is:inline src="/js/main.js"></script>
</Layout>

