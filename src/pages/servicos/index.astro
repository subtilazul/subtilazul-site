---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/sections/Navbar.astro";
import Footer from "../../components/sections/Footer.astro";
---

<Layout
  title="Serviços de Higienização Profissional | SubtilAzul"
  description="Conheça os serviços profissionais da SubtilAzul para empresas e instituições: lavagem de alcatifas, higienização de cadeiras de auditório e higienização de colchões para hotelaria."
>
  <Navbar />

  <main class="pb-16 pt-24 md:pb-24 md:pt-28">
    <section class="px-4 md:px-6">
      <div class="mx-auto w-full max-w-7xl">
        <div class="rounded-3xl border border-slate-200/80 bg-white/95 p-6 shadow-sm md:p-10">
          <p class="inline-flex rounded-full border border-cyan-200 bg-cyan-50 px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-cyan-800">
            Serviços SubtilAzul
          </p>
          <h1 class="mt-4 text-balance text-4xl leading-tight text-slate-900 md:text-6xl">
            Soluções de Higienização para Empresas e Instituições
          </h1>
          <p class="mt-4 max-w-3xl text-base leading-relaxed text-slate-600 md:text-lg">
            Desenvolvemos intervenções técnicas de higienização com foco em qualidade operacional,
            preservação de ativos e conforto dos utilizadores.
          </p>
        </div>
      </div>
    </section>

    <section class="mt-10 px-4 md:mt-14 md:px-6">
      <div class="mx-auto grid w-full max-w-7xl gap-6 md:grid-cols-3">
        <a href="/servicos/lavagem-alcatifas-empresas" class="group rounded-3xl border border-slate-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
          <h2 class="text-2xl text-slate-900 transition group-hover:text-cyan-800">Lavagem de Alcatifas para Empresas</h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            Higienização profunda de alcatifas em áreas de tráfego intenso, escritórios, auditórios e zonas comuns.
          </p>
          <p class="mt-5 text-sm font-semibold text-cyan-700">Ver serviço</p>
        </a>

        <a href="/servicos/higienizacao-cadeiras-auditorio" class="group rounded-3xl border border-slate-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
          <h2 class="text-2xl text-slate-900 transition group-hover:text-cyan-800">Higienização de Cadeiras de Auditório</h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            Limpeza técnica de cadeiras estofadas em auditórios e salas de conferência com planeamento operacional.
          </p>
          <p class="mt-5 text-sm font-semibold text-cyan-700">Ver serviço</p>
        </a>

        <a href="/servicos/higienizacao-colchao-hotel" class="group rounded-3xl border border-slate-200 bg-white p-7 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
          <h2 class="text-2xl text-slate-900 transition group-hover:text-cyan-800">Higienização de Colchões para Hotelaria</h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            Serviço especializado para unidades hoteleiras com foco em salubridade, conforto e consistência de qualidade.
          </p>
          <p class="mt-5 text-sm font-semibold text-cyan-700">Ver serviço</p>
        </a>
      </div>
    </section>
  </main>

  <Footer />
  <script is:inline src="/js/main.js"></script>
</Layout>
