                  Segunda a Sexta: 9h - 18h<br />Disponíveis para agendamentos
                </p>
              </div>
            </div>
          </div>

          <div class="contact-form">
            <h3>Solicite uma Avaliação</h3>
            <form
              id="contactForm"
              action="https://api.web3forms.com/submit"
              method="POST"
            >
              <!-- Web3Forms Access Key -->
              <input
                type="hidden"
                name="access_key"
                value="ab4e72ad-88c9-4ca9-86a8-2550b120a61b"
              />
              <input
                type="hidden"
                name="subject"
                value="Nova Solicitação - SubtilAzul"
              />
              <input
                type="hidden"
                name="from_name"
                value="Website SubtilAzul"
              />

              <div class="form-group">
                <label for="name">Nome *</label>
                <input type="text" id="name" name="name" required />
              </div>

              <div class="form-group">
                <label for="company">Empresa/Instituição *</label>
                <input type="text" id="company" name="company" required />
              </div>

              <div class="form-group">
                <label for="email">Email *</label>
                <input type="email" id="email" name="email" required />
              </div>

              <div class="form-group">
                <label for="phone">Telefone </label>
                <input type="tel" id="phone" name="phone" />
              </div>

              <div class="form-group">
                <label for="service">Serviço de Interesse *</label>
                <select id="service" name="service" required>
                  <option value="">Selecione um serviço</option>
                  <option value="alcatifas">Alcatifas</option>
                  <option value="cadeiras">Cadeiras / Mobiliário Estofado</option>                  
                  <option value="colchoes">Colchões</option>
                  <option value="varios">Vários Serviços</option>                  
                </select>
              </div>

              <div class="form-group">
                <label for="message">Mensagem</label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  placeholder="Descreva brevemente as suas necessidades..."
                ></textarea>
              </div>

              <button type="submit" class="form-submit">Enviar Pedido</button>

              <div id="successMessage" class="success-message">
                ✓ Mensagem enviada com sucesso! Entraremos em contacto em breve.
              </div>
              <div id="errorMessage" class="success-message error-message">
                Ocorreu um erro ao enviar. Tente novamente em instantes.
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>

