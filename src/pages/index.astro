    <!-- Services Section -->
    <section id="servicos" class="services">
      <div class="container">
        <div class="section-title">
          <h2>Os Nossos Serviços</h2>
          <p class="section-subtitle">
            Soluções especializadas para preservar e revitalizar os seus espaços
          </p>
        </div>
        <div class="services-grid">
          <div class="service-card">
            <div class="service-icon" aria-hidden="true">
              <svg class="icon"><use href="#icon-building"></use></svg>
            </div>
            <h3>Alcatifas</h3>
            <p>
              Higienização profunda de alcatifas de pequena, média e grande
              dimensão. Áreas planas, degraus e zonas de alto tráfego com
              técnicas especializadas.
            </p>
          </div>
          <div class="service-card">
            <div class="service-icon" aria-hidden="true">
              <svg class="icon"><use href="#icon-chair"></use></svg>
            </div>
            <h3>Cadeiras & Poltronas</h3>
            <p>
              Lavagem de cadeiras de auditório, orquestra, executivo, banquete e
              refeição. Sofás, poltronas e cadeirões com metodologia adaptada.
            </p>
          </div>          
          <div class="service-card">
            <div class="service-icon" aria-hidden="true">
              <svg class="icon"><use href="#icon-bed"></use></svg>
            </div>
            <h3>Colchões</h3>
            <p>
              Higienização de colchões para hotéis em conformidade com a
              Portaria 309/2015, garantindo saúde e bem-estar.
            </p>
          </div>
        </div>
      </div>
    </section>

